# Copiá este archivo como .env y completá los valores de tu entorno.
# El .env nunca se sube al repositorio.
#
# Importante: las variables EXPO_PUBLIC_* quedan dentro de la app compilada
# y cualquiera puede leerlas. Acá van solo datos públicos (como la URL del
# servidor). Las claves de Google, Claude y Spotify viven únicamente en las
# variables de entorno del servidor, nunca en la app.

# URL del servidor propio (mood-app-back). Sin esta variable, en desarrollo se
# usa http://localhost:3000 (sirve en el simulador de iOS). En producción es
# obligatoria y tiene que ser https.
EXPO_PUBLIC_API_URL=http://localhost:3000
