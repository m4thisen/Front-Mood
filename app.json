{
  "expo": {
    "name": "Mood",
    "slug": "mood-diario-emocional",
    "scheme": "mood",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "backgroundColor": "#050B1E",
      "bundleIdentifier": "com.matiascasullo.mood"
    },
    "android": {
      "backgroundColor": "#050B1E",
      "package": "com.matiascasullo.mood"
    },
    "extra": {
      "supabaseUrl": "PEGÁ_ACÁ_LA_URL_DE_TU_PROYECTO_SUPABASE",
      "supabaseAnonKey": "PEGÁ_ACÁ_TU_ANON_KEY",
      "googleWebClientId": "PEGÁ_ACÁ_EL_WEB_CLIENT_ID_DE_GOOGLE_CLOUD"
    },
    "plugins": [
      ["expo-notifications", { "color": "#6C8CFF" }],
      "@react-native-google-signin/google-signin"
    ]
  }
}