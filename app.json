{
  "expo": {
    "name": "Mood",
    "slug": "mood-diario-emocional",
    "scheme": "mood",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "backgroundColor": "#050B1E",
      "bundleIdentifier": "com.matiascasullo.mood"
    },
    "android": {
      "backgroundColor": "#050B1E",
      "package": "com.matiascasullo.mood"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#6C8CFF"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.64652794829-k11tg09m1soe0cq626883mrp5f5hqcrl"
        }
      ],
      "expo-sqlite"
    ]
  }
}
